# Google AI API key — lay tai https://aistudio.google.com/apikey
# BAT BUOC: model sinh anh khong co free tier, can bat billing cho project
GEMINI_API_KEY=

# Model text (co free tier)
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Model sinh anh (KHONG co free tier)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Port — Render tu set bien nay
PORT=3000

# Che do sinh anh:
#   prompt (mac dinh) = chi xuat prompt, ban tu dan vao Gemini app — MIEN PHI
#   api               = app tu sinh anh, CAN bat billing (model anh khong co free tier)
IMAGE_MODE=prompt
